# ===============================================
# ⚡ OrbiBot - Plantilla de Variables de Entorno
# ===============================================

PORT=3000
NODE_ENV=production

# Kick OAuth: crea una app en Kick Dev y registra esta URL de redirección.
KICK_CLIENT_ID=tu_kick_client_id
KICK_CLIENT_SECRET=tu_kick_client_secret
KICK_REDIRECT_URI=http://127.0.0.1:3000/api/auth/kick/callback

# 🟣 Twitch API
TWITCH_CLIENT_ID=yw1vr664ichms8an2x5lhji58v7ozk

# 🟢 Supabase Cloud Database (Configura tus claves)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_supabase_publishable_key
SUPABASE_SECRET_KEY=tu_supabase_secret_key
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# 🍃 MongoDB Cloud Database (Doble Respaldo Simultáneo)
MONGODB_URI=mongodb+srv://usuario:contraseña@servidor.mongodb.net/orbibot?retryWrites=true&w=majority

